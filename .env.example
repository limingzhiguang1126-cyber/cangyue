# ============================================================
# 环境变量模板 —— 复制为 .env 并填入真实值
# ============================================================

# DeepSeek AI（Phase 2 起需要，Phase 1 可留空）
DEEPSEEK_API_BASE=
DEEPSEEK_API_KEY=

# Telegram Bot（Phase 1 必填）
# 通过 @BotFather 创建 Bot 获取 token
TELEGRAM_BOT_TOKEN=
# 目标频道/群组的 chat_id（可用 @userinfobot 查询）
TELEGRAM_CHAT_ID=

# 日志级别
LOG_LEVEL=info
