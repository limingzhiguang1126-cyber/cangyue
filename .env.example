# ============================================================
# 环境变量模板 —— 复制为 .env 并填入真实值
# ============================================================

# DeepSeek AI（Phase 2 起需要，Phase 1 可留空）
DEEPSEEK_API_BASE=
DEEPSEEK_API_KEY=

# Telegram Bot（Phase 1 必填）
# 通过 @BotFather 创建 Bot 获取 token
TELEGRAM_BOT_TOKEN=
# 目标频道/群组的 chat_id（可用 @userinfobot 查询）
TELEGRAM_CHAT_ID=

# v1.1 信号守护进程（v11_signal_daemon）可选参数
# 轮询间隔（分钟），默认 15
# V11_POLL_INTERVAL=15
# 去重窗口（秒），同标的同信号线在此窗口内只推一次，默认 7200=2h
# V11_DEDUP_WINDOW=7200
# 候选池 JSON 路径，默认 data/smallcap_top100_fdv.json
# V11_POOL=data/smallcap_top100_fdv.json

# 日志级别
LOG_LEVEL=info
